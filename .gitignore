# Python
.venv/
__pycache__/
*.py[oc]
build/
dist/
*.egg-info
.pytest_cache/

# Secrets and local account list (IBM credentials live in ~/.qiskit, never here)
config/accounts.toml
.env
.env.*
qiskit-ibm.json

# Jobs submitted but not fetched yet (moved into data/raw/<device>/ by `qdrift fetch`)
data/raw/pending/

# Dry-run outputs (regenerate with `qdrift dryrun-campaign`)
data/dry-run/
results/dry-run/

# Downloaded papers: personal reading copies, not for redistribution
literature/pdfs/

# Paper build output (rebuild with `uv run qdrift paper --build`)
paper/build/

# LaTeX build files
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
